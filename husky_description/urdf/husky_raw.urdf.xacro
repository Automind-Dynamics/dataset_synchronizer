<?xml version="1.0"?>

<robot name="husky_a300" xmlns:xacro="https://ros.org/wiki/xacro">

    <!-- xacro properties -->
    <xacro:property name="PI" value="3.14159"/>

    <!-- xacro args -->
    <xacro:arg name="ouster_frames_enable" default="true" />
    <xacro:arg name="zedx_front_frames_enable" default="true" />

    <xacro:arg name="robot_namespace" default="/" />


        <link name="base_footprint"/>

        <link name="base_link"/>

        <!-- Joint from base_footprint to base link(chassis) -->
        <joint name="base_link_joint" type="fixed">
            <origin xyz="0.0 0 0.0" rpy="0 0 0" />
            <parent link="base_footprint" />
            <child link="base_link" />
        </joint>


        <link name="sensor_suite_base"/>

        <!-- Joint from base_link to sensor_suite_base -->
        <joint name="sensor_suite_base_joint" type="fixed">
            <origin xyz="0.0 0.0 0.24226" rpy="0 0 0" />
            <parent link="base_link" />
            <child link="sensor_suite_base" />
        </joint>


        <link name="os_sensor"/>

        <!-- Joint from sensor_suite_base to ouster -->
        <joint name="os_sensor_joint" type="fixed">
            <origin xyz="0.17524 0 0.28733" rpy="0 0.0 0" />
            <!-- <origin xyz="0.17524 0 0.28733" rpy="0 0.122173 0" /> -->
            <parent link="sensor_suite_base" />
            <child link="os_sensor" />
        </joint>


        <link name="zedx_front_camera_link"/>

        <!-- Joint from sensor_suite_base to zed_front -->
        <joint name="zedx_front_camera_link_joint" type="fixed">
            <origin xyz="0.26750 0 0.21091" rpy="0 0 0" />
            <parent link="sensor_suite_base" />
            <child link="zedx_front_camera_link" />
        </joint>
        
        
        <link name="imu_link"/>

        <!-- Joint from sensor_suite_base to zed_front -->
        <joint name="imu_link_joint" type="fixed">
            <origin xyz="0.205 0.0 0.0" rpy="0 0 0" />
            <parent link="sensor_suite_base" />
            <child link="imu_link" />
        </joint>





        <!-- OUSTER FRAMES -->
        <xacro:if value="$(arg ouster_frames_enable)">

            <link name="os_imu"/>

            <!-- Joint from os_sensor to os_imu -->
            <joint name="os_imu_joint" type="fixed">
                <origin xyz="0.006253 -0.011775 0.007645" rpy="0 0 0" />
                <parent link="os_sensor" />
                <child link="os_imu" />
            </joint>

            <link name="os_lidar"/>

            <!-- Joint from os_sensor to os_lidar -->
            <joint name="os_lidar_joint" type="fixed">
                <origin xyz="0.000000 0.000000 0.036180" rpy="0.000000 0.000000 3.141593" />
                <parent link="os_sensor" />
                <child link="os_lidar" />
            </joint>

        </xacro:if>








        <!-- ZEDX FRONT CAMERA FRAMES -->

        <xacro:if value="$(arg zedx_front_frames_enable)">

            <link name="zedx_front_camera_center"/>

            <!-- Joint from zedx_front_camera_link to zedx_front_camera_center -->
            <joint name="zedx_front_camera_center_joint" type="fixed">
                <origin xyz="0.000000 0.000000 0.016000" rpy="0 0 0" />
                <parent link="zedx_front_camera_link" />
                <child link="zedx_front_camera_center" />
            </joint>

            <link name="zedx_front_left_camera_frame"/>

            <!-- Joint from zedx_front_camera_center to zedx_front_left_camera_frame -->
            <joint name="zedx_front_left_camera_frame_joint" type="fixed">
                <origin xyz="-0.010000 0.060170 0.000000" rpy="0 0 0" />
                <parent link="zedx_front_camera_center" />
                <child link="zedx_front_left_camera_frame" />
            </joint>

            <link name="zedx_front_right_camera_frame"/>

            <!-- Joint from zedx_front_camera_center to zedx_front_right_camera_frame -->
            <joint name="zedx_front_right_camera_frame_joint" type="fixed">
                <origin xyz="-0.010000 -0.060170 0.000000" rpy="0 0 0" />
                <parent link="zedx_front_camera_center" />
                <child link="zedx_front_right_camera_frame" />
            </joint>

            <link name="zedx_front_left_camera_frame_optical"/>

            <!-- Joint from zedx_front_left_camera_frame to zedx_front_left_camera_frame_optical -->
            <joint name="zedx_front_left_camera_frame_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="-1.570796 0.000000 -1.570796" />
                <parent link="zedx_front_left_camera_frame" />
                <child link="zedx_front_left_camera_frame_optical" />
            </joint>

            <link name="zedx_front_right_camera_frame_optical"/>

            <!-- Joint from zedx_front_right_camera_frame to zedx_front_right_camera_frame_optical -->
            <joint name="zedx_front_right_camera_frame_optical_joint" type="fixed">
                <origin xyz="0 0 0" rpy="-1.570796 0.000000 -1.570796" />
                <parent link="zedx_front_right_camera_frame" />
                <child link="zedx_front_right_camera_frame_optical" />
            </joint>

        </xacro:if>


</robot>
